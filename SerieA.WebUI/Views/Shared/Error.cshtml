@model SerieA.WebUI.Models.ErrorViewModel
@{
    ViewData["Title"] = $"Hata ({Model.StatusCode})";
    ViewData["Crumb"] = "Sistem Hatası";
    Layout = "_AdminLayout";
}

<div class="error-page-shell" style="min-height: 65vh; display: flex; align-items: center; justify-content: center; padding: 40px 16px;">
    <div class="card-a" style="max-width: 540px; width: 100%; text-align: center; padding: 48px 32px; border-radius: 16px; border: 1px solid var(--line); box-shadow: 0 16px 36px rgba(0,0,0,0.25);">
        
        <!-- Big Lucide Alert Icon with status badge -->
        <div style="width: 76px; height: 76px; margin: 0 auto 24px; border-radius: 20px; background: rgba(245, 158, 11, 0.12); border: 1px solid rgba(245, 158, 11, 0.28); display: grid; place-items: center; color: #F59E0B;">
            <svg class="icon icon--xl" style="width: 38px; height: 38px;" aria-hidden="true">
                <use href="#lucide-alert-triangle"></use>
            </svg>
        </div>

        <span style="font-family: 'Barlow Condensed', sans-serif; font-size: 1rem; font-weight: 700; letter-spacing: 1px; color: #F59E0B; text-transform: uppercase;">
            @(Model.StatusCode > 0 ? $"HTTP {Model.StatusCode}" : "SİSTEM UYARISI")
        </span>

        <h1 style="font-family: 'Barlow Condensed', sans-serif; font-size: 2.2rem; font-weight: 700; margin: 8px 0 16px; color: var(--text);">
            Bir Şeyler Ters Gitti
        </h1>

        <p style="color: var(--dim); font-size: 0.95rem; line-height: 1.55; margin: 0 0 28px;">
            @(Model.Message ?? "İsteğinizi işlerken beklenmedik bir durum meydana geldi. Oturum süreniz dolmuş olabilir veya sunucu geçici olarak yanıt veremiyor olabilir.")
        </p>

        <!-- Action Buttons -->
        <div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center;">
            <button type="button" onclick="window.location.reload();" class="btn-a btn-a--primary" style="padding: 10px 22px; font-weight: 600;">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#lucide-rotate-ccw"></use></svg>
                <span>Yeniden Dene</span>
            </button>
            <a href="/" class="btn-a btn-a--secondary" style="padding: 10px 22px; font-weight: 600;">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#lucide-home"></use></svg>
                <span>Ana Sayfa</span>
            </a>
            <a href="/Account/Login" class="btn-a btn-a--ghost" style="padding: 10px 20px; font-weight: 600;">
                <svg class="icon icon--sm" aria-hidden="true"><use href="#lucide-log-out" style="transform: rotate(180deg);"></use></svg>
                <span>Giriş Yap</span>
            </a>
        </div>
    </div>
</div>
