<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lega Serie A</title>

    <!-- Google Fonts: IBM Plex Sans & Condensed (Serie A Font Ailesi) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+Condensed:wght@600;700&family=Barlow+Condensed:wght@700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />

    <style>
        :root {
            --pub-bg: #0D0F13;
            --pub-surface: #171A21;
            --pub-surface-hover: #1F232C;
            --pub-line: #2A2F3A;
            --pub-text: #EEF1F6;
            --pub-muted: #9AA2B1;
            --pub-blue: #2A66E0;
            --pub-blue-bright: #78A9FF;
            --font-display: "IBM Plex Sans Condensed", "Barlow Condensed", sans-serif;
            --font-body: "IBM Plex Sans", -apple-system, sans-serif;
        }

        body.public-body {
            background-color: var(--pub-bg);
            color: var(--pub-text);
            font-family: var(--font-body);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            margin: 0;
            padding: 0;
        }

        /* Modern Public Navbar */
        .pub-header {
            background: rgba(18, 21, 27, 0.95);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid var(--pub-line);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .pub-navbar {
            max-width: 1280px;
            margin: 0 auto;
            padding: 0 24px;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .pub-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            color: #fff;
            user-select: none;
        }

        .pub-brand-logo {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #0047AB 0%, #002255 100%);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 10px;
            display: grid;
            place-items: center;
            font-family: var(--font-display);
            font-weight: 700;
            font-size: 1.15rem;
            color: #fff;
            box-shadow: 0 4px 12px rgba(0, 71, 171, 0.35);
            cursor: pointer;
            transition: transform 0.15s ease;
        }

        .pub-brand-logo:active {
            transform: scale(0.92);
        }

        .pub-brand-text {
            font-family: var(--font-display);
            font-size: 1.4rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .pub-nav-links {
            display: flex;
            align-items: center;
            gap: 8px;
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .pub-nav-link {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 8px 16px;
            border-radius: 8px;
            color: var(--pub-muted);
            text-decoration: none;
            font-size: 0.95rem;
            font-weight: 500;
            transition: all 0.15s ease;
        }

        .pub-nav-link:hover {
            color: #fff;
            background: var(--pub-surface-hover);
        }

        .pub-nav-link.is-active {
            color: #fff;
            background: rgba(42, 102, 224, 0.16);
            font-weight: 600;
            border: 1px solid rgba(42, 102, 224, 0.35);
        }

        .pub-nav-link.is-active .icon {
            color: var(--pub-blue-bright);
        }

        .pub-nav-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .pub-season-badge {
            font-size: 0.8rem;
            font-weight: 700;
            color: #8591A8;
            background: rgba(255, 255, 255, 0.05);
            padding: 4px 10px;
            border-radius: 6px;
            border: 1px solid rgba(255, 255, 255, 0.08);
            font-family: var(--font-display);
            letter-spacing: 0.5px;
        }

        .btn-pub-admin {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.15s ease;
            background: var(--pub-surface);
            color: #fff;
            border: 1px solid var(--pub-line);
        }

        .btn-pub-admin:hover {
            background: var(--pub-blue);
            border-color: var(--pub-blue);
            color: #fff;
            box-shadow: 0 4px 14px rgba(42, 102, 224, 0.3);
        }

        /* Public Main Container */
        .pub-main {
            flex: 1;
            max-width: 1280px;
            width: 100%;
            margin: 0 auto;
            padding: 32px 24px 64px;
        }

        /* Public Footer */
        .pub-footer {
            background: #0A0C10;
            border-top: 1px solid var(--pub-line);
            padding: 32px 24px;
            text-align: center;
            font-size: 0.85rem;
            color: var(--pub-muted);
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="public-body">
    <!-- Lucide SVG Sprite Sheet -->
    @await Html.PartialAsync("_AdminIcons")

    <!-- Public Navbar -->
    <header class="pub-header">
        <nav class="pub-navbar">
            <div class="pub-brand" id="brand-secret-trigger">
                @await Html.PartialAsync("_SerieALogo", new ViewDataDictionary(ViewData) { { "Height", "34px" } })
                <a href="/" style="text-decoration: none; color: inherit;"><span class="pub-brand-text">Serie A TIM</span></a>
            </div>

            <ul class="pub-nav-links">
                <li>
                    <a class="pub-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Fixtures" || ViewContext.RouteData.Values["controller"]?.ToString() == "Public" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "is-active" : "")" href="/Fikstur">
                        <svg class="icon icon--sm" aria-hidden="true"><use href="#lucide-calendar" /></svg>
                        <span>Fikstür & Sonuçlar</span>
                    </a>
                </li>
                <li>
                    <a class="pub-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Standings" ? "is-active" : "")" href="/Puan-Durumu">
                        <svg class="icon icon--sm" aria-hidden="true"><use href="#lucide-table" /></svg>
                        <span>Puan Durumu</span>
                    </a>
                </li>
            </ul>

            <div class="pub-nav-actions">
                <span class="pub-season-badge">2026/27 SEZONU</span>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a class="btn-pub-admin" href="/Admin" title="Yönetim Paneline Git">
                        <svg class="icon icon--xs" aria-hidden="true"><use href="#lucide-shield" /></svg>
                        <span>Panel</span>
                    </a>
                }
            </div>
        </nav>
    </header>

    <!-- Sayfa İçeriği -->
    <main class="pub-main">
        @RenderBody()
    </main>

    <!-- Public Footer -->
    <footer class="pub-footer">
        <div class="container">
            <p class="m-0">Lega Nazionale Professionisti Serie A &copy; 2026/27 &bull; Tüm Hakları Saklıdır.</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    
    <script>
        // Gizli Yönetici Girişi: Logoya 1 saniye içinde 3 kez tıklandığında Admin panele yönlendirir
        (function() {
            let clickCount = 0;
            let clickTimer = null;
            const logoTrigger = document.getElementById('brand-secret-trigger');

            if (logoTrigger) {
                logoTrigger.addEventListener('click', function(e) {
                    clickCount++;
                    if (clickCount === 1) {
                        clickTimer = setTimeout(() => {
                            clickCount = 0;
                        }, 1200);
                    } else if (clickCount >= 3) {
                        e.preventDefault();
                        clearTimeout(clickTimer);
                        clickCount = 0;
                        window.location.href = '/Admin';
                    }
                });
            }
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
