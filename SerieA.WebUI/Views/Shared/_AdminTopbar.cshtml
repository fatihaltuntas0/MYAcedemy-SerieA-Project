@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var userName = isAuthenticated ? (User.Identity?.Name ?? "Kullanıcı") : "Misafir";
    var isAdmin = User.IsInRole("Admin");
    var roleLabel = isAdmin ? "Yönetici" : "Editör";
    var roleSub = isAdmin ? "Tam yetkili" : "İçerik yöneticisi";

    var initials = !string.IsNullOrWhiteSpace(userName)
        ? string.Concat(userName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(s => s[0])).ToUpper()
        : "U";
}

<header class="admin-topbar">
    <div class="topbar-left">
        <button type="button" class="icon-btn menu-toggle" data-sidebar-toggle aria-controls="admin-sidebar" aria-expanded="false" aria-label="Menüyü aç">
            <svg class="icon icon--md" aria-hidden="true"><use href="#lucide-menu" /></svg>
        </button>
        <span class="topbar-crumb">Yönetim / @(ViewData["Crumb"] ?? ViewData["Title"])</span>
    </div>
    <div class="topbar-right">
        <div class="topbar-user" title="@userName (@roleLabel)">
            <span class="avatar" style="background: linear-gradient(135deg, var(--blue) 0%, #003380 100%); color: #fff; font-weight: 700; font-size: 0.85rem; display: grid; place-items: center; border: 1px solid rgba(255,255,255,0.15);">
                @initials
            </span>
            <span class="topbar-user__text">
                <span class="topbar-user__name">@userName</span>
                <span class="topbar-user__role">@roleSub</span>
            </span>
        </div>
    </div>
</header>
