<header class="admin-topbar">
    <div class="topbar-left">
        <button type="button" class="icon-btn menu-toggle" data-sidebar-toggle aria-controls="admin-sidebar" aria-expanded="false" aria-label="Menüyü aç">
            <svg class="icon icon--md" aria-hidden="true"><use href="#lucide-menu" /></svg>
        </button>
        <span class="topbar-crumb">Yönetim / @(ViewData["Crumb"] ?? ViewData["Title"])</span>
    </div>
    <div class="topbar-right">
        <button type="button" class="icon-btn" aria-label="Bildirimler, 3 okunmamış" data-demo-action>
            <svg class="icon icon--md" aria-hidden="true"><use href="#lucide-bell" /></svg><span class="notif-dot"></span>
        </button>
        <div class="topbar-user">
            <span class="avatar"><svg class="icon icon--md" aria-hidden="true"><use href="#lucide-user" /></svg></span>
            <span class="topbar-user__text"><span class="topbar-user__name">Yönetici</span><span class="topbar-user__role">Tam yetkili</span></span>
        </div>
    </div>
</header>
