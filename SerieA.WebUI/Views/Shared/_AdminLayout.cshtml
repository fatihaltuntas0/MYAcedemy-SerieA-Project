<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Serie A Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&family=Barlow+Condensed:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="admin">
    <!-- SVG İkon Seti -->
    @await Html.PartialAsync("_AdminIcons")

    <!-- Sidebar -->
    @await Html.PartialAsync("_AdminSidebar")

    <div class="admin-main">
        <!-- Topbar -->
        @await Html.PartialAsync("_AdminTopbar")

        <!-- Sayfa İçeriği (Index.cshtml buraya basılacak) -->
        <main class="admin-content">
            @RenderBody()
        </main>
    </div>

    <div class="toast-stack" data-toasts aria-live="polite"></div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.3/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
