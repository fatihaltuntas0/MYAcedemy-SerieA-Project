@model MatchIndexViewModel

<section class="card-a" aria-label="Maç listesi">
    <form class="filter-bar" method="get" asp-action="Index" role="search">
        <div class="filter-search">
            <label class="field-label" for="f-team">Takım Ara</label>
            <div class="input-icon">
                <svg class="icon" aria-hidden="true"><use href="#i-search" /></svg>
                <input class="input-a" id="f-team" name="team" type="search" value="@Model.SearchTeam" placeholder="Takım adı yazın" autocomplete="off">
            </div>
        </div>
        <div>
            <label class="field-label" for="f-week">Hafta Seç</label>
            <select class="select-a" id="f-week" name="week">
                <option value="">Tüm Haftalar</option>
                @for (int w = 1; w <= 38; w++)
                {
                    <option value="@w" selected="@(Model.SelectedWeek == w)">@w. Hafta</option>
                }
            </select>
        </div>
        <div>
            <label class="field-label" for="f-status">Durum</label>
            <select class="select-a" id="f-status" name="status">
                <option value="">Tümü</option>
                <option value="Oynanmadı" selected="@(Model.SelectedStatus == "Oynanmadı")">Oynanmadı</option>
                <option value="Canlı" selected="@(Model.SelectedStatus == "Canlı")">Canlı</option>
                <option value="Tamamlandı" selected="@(Model.SelectedStatus == "Tamamlandı")">Tamamlandı</option>
                <option value="Ertelendi" selected="@(Model.SelectedStatus == "Ertelendi")">Ertelendi</option>
            </select>
        </div>
        <div class="filter-actions">
            <a href="/Matches" class="btn-a btn-a--ghost">Temizle</a>
            <button type="submit" class="btn-a btn-a--secondary">Filtrele</button>
        </div>
    </form>

    <div class="table-scroll">
        <table class="team-table match-table">
            <thead>
                <tr>
                    <th scope="col" class="col-id">#</th>
                    <th scope="col">Hafta</th>
                    <th scope="col">Tarih & Saat</th>
                    <th scope="col">Ev Sahibi</th>
                    <th scope="col" class="col-score" style="text-align:center;">Skor</th>
                    <th scope="col">Deplasman</th>
                    <th scope="col">Stadyum</th>
                    <th scope="col">Durum</th>
                    <th scope="col" class="col-actions">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Matches.Any())
                {
                    <tr class="table-empty">
                        <td colspan="9">
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <svg class="icon" aria-hidden="true"><use href="#i-ball" /></svg>
                                </div>
                                <h3 class="empty-state-title">Kayıtlı Maç Bulunamadı</h3>
                                <p class="empty-state-desc">Seçilen hafta veya arama kriterine uygun karşılaşma kaydı bulunmuyor. Filtreleri temizleyebilir veya yeni maç ekleyebilirsiniz.</p>
                                <div class="empty-state-actions">
                                    <a href="/Matches" class="btn-a btn-a--secondary">Filtreleri Temizle</a>
                                    <button type="button" class="btn-a btn-a--primary" data-open-create>
                                        <svg class="icon" aria-hidden="true"><use href="#i-plus" /></svg>Yeni Maç Ekle
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    var index = 1;
                    @foreach (var m in Model.Matches)
                    {
                        <tr data-id="@m.Id">
                            <td class="col-id">@(index++)</td>
                            <td><strong>@m.Week. Hafta</strong></td>
                            <td>
                                <div>@m.MatchDate.ToString("dd.MM.yyyy")</div>
                                <small style="color:var(--muted)">@m.MatchDate.ToString("HH:mm")</small>
                            </td>
                            <td>
                                <div class="team-cell">
                                    @if (!string.IsNullOrEmpty(m.HomeTeamLogoUrl))
                                    {
                                        <img class="team-crest" src="@m.HomeTeamLogoUrl" alt="@m.HomeTeamName" onerror="this.style.display='none';" />
                                    }
                                    <span class="team-name">@m.HomeTeamName</span>
                                </div>
                            </td>
                            <td style="text-align:center;">
                                @if (m.HomeScore.HasValue && m.AwayScore.HasValue)
                                {
                                    <span class="match-score-pill @(m.Status.ToString() == "Live" || m.Status.ToString() == "Canlı" ? "match-score-pill--live" : "match-score-pill--finished")">
                                        @m.HomeScore : @m.AwayScore
                                    </span>
                                }
                                else
                                {
                                    <span class="match-score-pill match-score-pill--scheduled">VS</span>
                                }
                            </td>
                            <td>
                                <div class="team-cell">
                                    @if (!string.IsNullOrEmpty(m.AwayTeamLogoUrl))
                                    {
                                        <img class="team-crest" src="@m.AwayTeamLogoUrl" alt="@m.AwayTeamName" onerror="this.style.display='none';" />
                                    }
                                    <span class="team-name">@m.AwayTeamName</span>
                                </div>
                            </td>
                            <td><small>@m.Stadium</small></td>
                            <td>
                                <span class="badge-a badge-a--@m.Status.ToBadgeClass()">
                                    @if (m.Status.ToString() == "Live" || m.Status.ToString() == "Canlı")
                                    {
                                        <span class="live-dot" aria-hidden="true"></span>
                                    }
                                    @m.Status.ToDisplayStatus()
                                </span>
                            </td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <a class="act-btn" href="/Matches/Detail/@m.Id" title="Maç Detayı ve Olay Yönetimi">
                                        <svg class="icon" aria-hidden="true" viewBox="0 0 24 24"><path fill="currentColor" d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
                                    </a>
                                    <button type="button" class="act-btn" data-edit="@m.Id"
                                            data-match='@Json.Serialize(m)' title="Düzenle">
                                        <svg class="icon" aria-hidden="true"><use href="#i-edit" /></svg>
                                    </button>
                                    <button type="button" class="act-btn act-btn--danger" data-delete="@m.Id" 
                                            data-name="@m.HomeTeamName vs @m.AwayTeamName" title="Sil">
                                        <svg class="icon" aria-hidden="true"><use href="#i-trash" /></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="table-foot">
        <span>Toplam @Model.Matches.Count karşılaşma listelendi</span>
        <span>Serie A 2026/27 Sezonu</span>
    </div>
</section>
