@using SerieA.WebUI.DTOs.Matches
@using SerieA.WebUI.Enums
@model ResultMatchDetailDto

@{
    ViewData["Title"] = $"{Model.HomeTeamName} vs {Model.AwayTeamName} - Maç Detayı";
    ViewData["Crumb"] = "Maçlar / Detay";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var homeGoalsCount = Model.Goals.Count(g => g.TeamId == Model.HomeTeamId);
    var awayGoalsCount = Model.Goals.Count(g => g.TeamId == Model.AwayTeamId);
    var hasScoreMismatch = Model.Status == MatchStatus.Finished &&
                          ((Model.HomeScore ?? 0) != homeGoalsCount || (Model.AwayScore ?? 0) != awayGoalsCount);

    int ParseMinute(string min)
    {
        if (string.IsNullOrWhiteSpace(min)) return 0;
        var parts = min.Split('+');
        if (int.TryParse(parts[0], out var baseMin))
        {
            var added = parts.Length > 1 && int.TryParse(parts[1], out var ext) ? ext : 0;
            return baseMin * 100 + added;
        }
        return 0;
    }

    // Combine and sort events
    var eventItems = new List<(Guid Id, string Type, Guid TeamId, string TeamName, string Minute, int SortKey, string PlayerName, string PlayerOut, CardType? CardType)>();

    foreach (var g in Model.Goals)
    {
        eventItems.Add((g.Id, "goal", g.TeamId, g.TeamName, g.Minute, ParseMinute(g.Minute), g.PlayerName, "", null));
    }

    foreach (var c in Model.Cards)
    {
        eventItems.Add((c.Id, "card", c.TeamId, c.TeamName, c.Minute, ParseMinute(c.Minute), c.PlayerName, "", c.CardType));
    }

    foreach (var s in Model.Substitutions)
    {
        eventItems.Add((s.Id, "sub", s.TeamId, s.TeamName, s.Minute, ParseMinute(s.Minute), s.PlayerIn, s.PlayerOut, null));
    }

    var sortedEvents = eventItems.OrderBy(e => e.SortKey).ToList();
}

@section Styles {
    <link rel="stylesheet" href="~/css/match-detail.css" asp-append-version="true" />
}

<div class="match-detail-page"
     id="match-detail-container"
     data-subs-out='@Json.Serialize(Model.Substitutions.Select(s => new { player = s.PlayerOut, minute = s.Minute, teamId = s.TeamId }))'
     data-subs-in='@Json.Serialize(Model.Substitutions.Select(s => new { player = s.PlayerIn, minute = s.Minute, teamId = s.TeamId }))'
     data-red-cards='@Json.Serialize(Model.Cards.Where(c => c.CardType == CardType.Red).Select(c => new { player = c.PlayerName, minute = c.Minute, teamId = c.TeamId }))'>
    <input type="hidden" id="match-id-holder" value="@Model.Id" />

    <!-- Page Header -->
    <div class="page-head">
        <div>
            <h1 class="page-title">Maç Detayı</h1>
            <p class="page-desc">Skor, gol, kart ve oyuncu değişikliği kayıtlarını görüntüleyin ve yönetin.</p>
        </div>
        <div class="filter-actions">
            <a class="btn-a btn-a--secondary" asp-action="Index">
                <svg class="icon" aria-hidden="true"><use href="#lucide-trophy" /></svg>
                Maçlara Dön
            </a>
            <button type="button" class="btn-a btn-a--primary" data-open-event-modal>
                <svg class="icon" aria-hidden="true"><use href="#lucide-plus" /></svg>
                Olay Ekle
            </button>
        </div>
    </div>

    <!-- Scoreboard Card -->
    <section class="card-a scoreboard" aria-label="Skor Tabelası">
        <div class="scoreboard-body">
            <!-- Home Team -->
            <div class="sb-team sb-team--home">
                <div class="sb-crest-wrap">
                    @if (!string.IsNullOrEmpty(Model.HomeTeamLogoUrl))
                    {
                        <img class="sb-crest" src="@Model.HomeTeamLogoUrl" alt="@Model.HomeTeamName" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />
                        <span class="sb-team-code" style="display:none;">@Model.HomeTeamCode</span>
                    }
                    else
                    {
                        <span class="sb-team-code">@Model.HomeTeamCode</span>
                    }
                </div>
                <h2 class="sb-team-name">@Model.HomeTeamName</h2>
                <span class="sb-team-role">Ev Sahibi</span>
            </div>

            <!-- Score & Status -->
            <div class="sb-center">
                <div class="sb-score-box">
                    @if (Model.Status == MatchStatus.Live || Model.Status == MatchStatus.Finished)
                    {
                        <span class="sb-score-num">@(Model.HomeScore ?? 0)</span>
                        <span class="sb-score-colon">:</span>
                        <span class="sb-score-num">@(Model.AwayScore ?? 0)</span>
                    }
                    else
                    {
                        <span class="sb-score-unstarted">- : -</span>
                    }
                </div>

                @if (Model.Status == MatchStatus.Live)
                {
                    <span class="badge-a badge-a--Live">
                        <span class="live-dot" style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#16a34a; margin-right:4px; box-shadow:0 0 0 3px rgba(22,163,74,0.2);"></span>
                        Canlı
                    </span>
                }
                else if (Model.Status == MatchStatus.Finished)
                {
                    <span class="badge-a badge-a--Finished">Tamamlandı</span>
                }
                else if (Model.Status == MatchStatus.Postponed)
                {
                    <span class="badge-a badge-a--Postponed">Ertelendi</span>
                }
                else
                {
                    <span class="badge-a badge-a--NotStarted">Başlamadı</span>
                }
            </div>

            <!-- Away Team -->
            <div class="sb-team sb-team--away">
                <div class="sb-crest-wrap">
                    @if (!string.IsNullOrEmpty(Model.AwayTeamLogoUrl))
                    {
                        <img class="sb-crest" src="@Model.AwayTeamLogoUrl" alt="@Model.AwayTeamName" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-flex';" />
                        <span class="sb-team-code" style="display:none;">@Model.AwayTeamCode</span>
                    }
                    else
                    {
                        <span class="sb-team-code">@Model.AwayTeamCode</span>
                    }
                </div>
                <h2 class="sb-team-name">@Model.AwayTeamName</h2>
                <span class="sb-team-role">Deplasman</span>
            </div>
        </div>

        <!-- Match Meta Strip -->
        <div class="sb-meta-strip">
            <span class="sb-meta-item">
                <svg class="icon" aria-hidden="true"><use href="#lucide-calendar" /></svg>
                <strong>@Model.Week. Hafta</strong>
            </span>
            <span class="sb-meta-dot"></span>
            <span class="sb-meta-item">
                <svg class="icon" aria-hidden="true"><use href="#lucide-clock" /></svg>
                @Model.MatchDate.ToString("dd.MM.yyyy HH:mm")
            </span>
            <span class="sb-meta-dot"></span>
            <span class="sb-meta-item">
                <svg class="icon" aria-hidden="true"><use href="#lucide-map-pin" /></svg>
                @Model.Stadium
            </span>
        </div>
    </section>

    <!-- Mismatch Warning Banner -->
    @if (hasScoreMismatch)
    {
        <div class="mismatch-banner" role="alert">
            <svg class="icon mismatch-icon" aria-hidden="true"><use href="#lucide-info" /></svg>
            <div class="mismatch-content">
                <div class="mismatch-title">Skor ve Gol Kaydı Uyuşmazlığı</div>
                <p class="mismatch-desc">
                    Maç sonucu resmi olarak <strong>@Model.HomeScore - @Model.AwayScore</strong> olarak tescil edilmiş, ancak kaydedilen gol sayısı <strong>@homeGoalsCount - @awayGoalsCount</strong> olarak görünüyor.
                    İstatistiklerin ve puan tablosunun tutarlı kalması için lütfen eksik veya fazla gol kayıtlarını düzenleyiniz.
                </p>
            </div>
        </div>
    }

    <!-- Two-Column Bento Grid -->
    <div class="detail-grid">
        <!-- Left: Match Event Timeline -->
        <section class="card-a" aria-label="Olay Akışı">
            <div class="detail-card-head">
                <h2 class="detail-card-title">
                    <svg class="icon" aria-hidden="true"><use href="#lucide-clock" /></svg>
                    Olay Akışı
                </h2>
                <span class="detail-badge-count">@sortedEvents.Count Olay</span>
            </div>

            <div class="tl-container">
                @if (sortedEvents.Count == 0)
                {
                    <div class="empty-state" style="padding: 40px 16px;">
                        <div class="empty-state-icon">
                            <svg class="icon" aria-hidden="true"><use href="#lucide-trophy" /></svg>
                        </div>
                        <p class="empty-state-title">Henüz Kayıtlı Olay Yok</p>
                        <p class="empty-state-desc">Bu maça ait henüz gol, kart veya oyuncu değişikliği kaydı bulunmuyor.</p>
                        <button type="button" class="btn-a btn-a--primary" data-open-event-modal>
                            <svg class="icon" aria-hidden="true"><use href="#lucide-plus" /></svg>
                            İlk Olayı Ekle
                        </button>
                    </div>
                }
                else
                {
                    <div class="tl">
                        @{
                            bool htMarkerRendered = false;
                            bool ftMarkerRendered = false;
                        }

                        @for (int i = 0; i < sortedEvents.Count; i++)
                        {
                            var ev = sortedEvents[i];
                            bool isHome = ev.TeamId == Model.HomeTeamId;

                            // Insert Half-Time separator if transition between first & second half
                            if (!htMarkerRendered && ev.SortKey > 4599)
                            {
                                <div class="tl-period-separator">45' · Devre Arası</div>
                                htMarkerRendered = true;
                            }

                            <div class="tl-row">
                                <span class="tl-min">@ev.Minute'</span>

                                <div class="tl-side @(isHome ? "tl-side--home" : "tl-side--away")">
                                    @if (ev.Type == "goal")
                                    {
                                        <div class="tl-event-pill tl-event-pill--goal">
                                            <span>⚽</span>
                                            <span class="tl-player-name">@ev.PlayerName</span>
                                        </div>
                                    }
                                    else if (ev.Type == "card")
                                    {
                                        var isRed = ev.CardType == CardType.Red;
                                        <div class="tl-event-pill @(isRed ? "tl-event-pill--red-card" : "tl-event-pill--yellow-card")">
                                            <span class="tl-card-rect @(isRed ? "tl-card-rect--red" : "tl-card-rect--yellow")"></span>
                                            <span class="tl-player-name">@ev.PlayerName</span>
                                        </div>
                                    }
                                    else if (ev.Type == "sub")
                                    {
                                        <div class="tl-event-pill">
                                            <div class="tl-sub-box">
                                                <span class="tl-sub-in">↑ @ev.PlayerName</span>
                                                <span class="tl-sub-out">↓ @ev.PlayerOut</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @if (Model.Status == MatchStatus.Finished)
                        {
                            <div class="tl-period-separator" style="margin-top: 8px;">90' · Maç Sonu</div>
                        }
                    </div>
                }
            </div>
        </section>

        <!-- Right: Event Records Table -->
        <section class="card-a" aria-label="Olay Kayıtları">
            <div class="detail-card-head">
                <h2 class="detail-card-title">
                    <svg class="icon" aria-hidden="true"><use href="#lucide-table" /></svg>
                    Olay Kayıtları
                </h2>
                <span class="detail-badge-count">@sortedEvents.Count Kayıt</span>
            </div>

            <div class="table-scroll">
                <table class="match-table" style="min-width: 480px;">
                    <thead>
                        <tr>
                            <th scope="col" style="width: 70px;">Dk.</th>
                            <th scope="col" style="width: 90px;">Tür</th>
                            <th scope="col">Takım</th>
                            <th scope="col">Detay</th>
                            <th scope="col" class="col-actions" style="width: 60px;">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (sortedEvents.Count == 0)
                        {
                            <tr class="table-empty">
                                <td colspan="5">
                                    <div style="padding: 24px; text-align: center; color: var(--muted);">
                                        <strong>Kayıt bulunamadı</strong>
                                        <p style="margin: 4px 0 0; font-size: 0.82rem;">"Olay Ekle" butonunu kullanarak bu müsabakaya gol, kart ve değişiklik girebilirsiniz.</p>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var ev in sortedEvents)
                            {
                                var eventSummary = ev.Type == "goal" ? $"{ev.PlayerName} (Gol)"
                                : ev.Type == "card" ? $"{(ev.CardType == CardType.Red ? "Kırmızı Kart" : "Sarı Kart")}: {ev.PlayerName}"
                                : $"Değişiklik: {ev.PlayerName} / {ev.PlayerOut}";

                                <tr>
                                    <td><strong>@ev.Minute'</strong></td>
                                    <td>
                                        @if (ev.Type == "goal")
                                        {
                                            <span class="ev-type-chip ev-type-chip--goal"><svg class="icon icon--xs" aria-hidden="true"><use href="#lucide-trophy" /></svg> Gol</span>
                                        }
                                        else if (ev.Type == "card")
                                        {
                                            if (ev.CardType == CardType.Red)
                                            {
                                                <span class="ev-type-chip ev-type-chip--red-card"><svg class="icon icon--xs" aria-hidden="true"><use href="#lucide-square" /></svg> Kırmızı</span>
                                            }
                                            else
                                            {
                                                <span class="ev-type-chip ev-type-chip--yellow-card"><svg class="icon icon--xs" aria-hidden="true"><use href="#lucide-square" /></svg> Sarı</span>
                                            }
                                        }
                                        else if (ev.Type == "sub")
                                        {
                                            <span class="ev-type-chip ev-type-chip--sub"><svg class="icon icon--xs" aria-hidden="true"><use href="#lucide-arrow-left-right" /></svg> Değişiklik</span>
                                        }
                                    </td>
                                    <td>
                                        <strong>@ev.TeamName</strong>
                                    </td>
                                    <td>
                                        @if (ev.Type == "goal")
                                        {
                                            <span>@ev.PlayerName</span>
                                        }
                                        else if (ev.Type == "card")
                                        {
                                            <span>@ev.PlayerName</span>
                                        }
                                        else if (ev.Type == "sub")
                                        {
                                            <span class="tl-sub-in">↑ @ev.PlayerName</span>
                                            <span style="color:var(--muted); margin:0 4px;">/</span>
                                            <span class="tl-sub-out">↓ @ev.PlayerOut</span>
                                        }
                                    </td>
                                    <td class="col-actions">
                                        <button type="button"
                                                class="act-btn act-btn--danger"
                                                data-delete-event
                                                data-id="@ev.Id"
                                                data-type="@ev.Type"
                                                data-label="@eventSummary"
                                                title="Olayı Sil"
                                                aria-label="Olayı sil">
                                            <svg class="icon" aria-hidden="true"><use href="#lucide-trash-2" /></svg>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="table-foot">
                <span>@sortedEvents.Count olay listeleniyor</span>
                <span>Tüm olaylar bu maça bağlıdır</span>
            </div>
        </section>
    </div>
</div>

<!-- Add Event Modal -->
<dialog class="modal-a" id="event-modal" aria-labelledby="event-modal-title">
    <form id="event-form" novalidate>
        <div class="modal-head">
            <h2 class="modal-title" id="event-modal-title">Olay Ekle</h2>
            <button type="button" class="icon-btn" data-modal-close aria-label="Kapat">
                <svg class="icon" aria-hidden="true"><use href="#lucide-x" /></svg>
            </button>
        </div>
        <div class="modal-body">
            <div class="form-alert" id="event-form-alert" role="alert" style="display:none;"></div>
            <div class="form-grid">
                <div class="form-field">
                    <label class="field-label" for="ev-type">Olay Türü</label>
                    <select class="select-a" id="ev-type" name="type">
                        <option value="Goal">Gol</option>
                        <option value="Card">Kart (Sarı / Kırmızı)</option>
                        <option value="Substitution">Oyuncu Değişikliği</option>
                    </select>
                </div>
                <div class="form-field">
                    <label class="field-label" for="ev-team">Takım <span class="req">*</span></label>
                    <select class="select-a" id="ev-team" name="teamId">
                        <option value="">Takım seçiniz</option>
                        <option value="@Model.HomeTeamId" data-code="@Model.HomeTeamCode">@Model.HomeTeamName (Ev Sahibi)</option>
                        <option value="@Model.AwayTeamId" data-code="@Model.AwayTeamCode">@Model.AwayTeamName (Deplasman)</option>
                    </select>
                    <p class="field-error"></p>
                </div>
                <div class="form-field" id="ev-field-player">
                    <label class="field-label" for="ev-player-select" id="ev-player-label">Golü Atan Oyuncu <span class="req">*</span></label>
                    <select class="select-a" id="ev-player-select">
                        <option value="">Lütfen önce takım seçiniz...</option>
                    </select>
                    <div id="ev-player-manual-wrap" style="display:none; margin-top:8px;">
                        <input class="input-a" id="ev-player" name="player" type="text" placeholder="Oyuncu adını yazınız..." autocomplete="off" />
                    </div>
                    <p class="field-error"></p>
                </div>
                <div class="form-field" id="ev-field-player-out" style="display:none;">
                    <label class="field-label" for="ev-player-out-select">Oyundan Çıkan Oyuncu <span class="req">*</span></label>
                    <select class="select-a" id="ev-player-out-select">
                        <option value="">Lütfen önce takım seçiniz...</option>
                    </select>
                    <div id="ev-player-out-manual-wrap" style="display:none; margin-top:8px;">
                        <input class="input-a" id="ev-player-out" name="playerOut" type="text" placeholder="Çıkan oyuncu adını yazınız..." autocomplete="off" />
                    </div>
                    <p class="field-error"></p>
                </div>
                <div class="form-field" id="ev-field-card" style="display:none;">
                    <label class="field-label" for="ev-card-type">Kart Türü</label>
                    <select class="select-a" id="ev-card-type" name="cardType">
                        <option value="Yellow">🟨 Sarı Kart</option>
                        <option value="Red">🟥 Kırmızı Kart</option>
                    </select>
                </div>
                <div class="form-field" id="ev-field-minute">
                    <label class="field-label" for="ev-minute">Dakika <span class="req">*</span></label>
                    <input class="input-a" id="ev-minute" name="minute" type="text" inputmode="numeric" placeholder="örn. 67 veya 90+2" autocomplete="off" />
                    <p class="field-error"></p>
                    <span style="font-size: 0.75rem; color: var(--muted); margin-top: 3px; display: block;">1-120 veya duraklama dakikası (örn: 45+2, 90+4)</span>
                </div>
            </div>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn-a btn-a--secondary" data-modal-close>Vazgeç</button>
            <button type="submit" id="ev-submit-btn" class="btn-a btn-a--primary">
                <svg class="icon" aria-hidden="true"><use href="#lucide-check" /></svg>
                Kaydet
            </button>
        </div>
    </form>
</dialog>

<!-- Delete Event Modal -->
<dialog class="modal-a" id="delete-event-modal" aria-labelledby="delete-event-title">
    <form id="delete-event-form">
        <div class="modal-head">
            <h2 class="modal-title" id="delete-event-title">Olayı Sil</h2>
            <button type="button" class="icon-btn" data-modal-close aria-label="Kapat">
                <svg class="icon" aria-hidden="true"><use href="#lucide-x" /></svg>
            </button>
        </div>
        <div class="modal-body">
            <p id="delete-event-text" style="color:var(--text); line-height: 1.5; margin:0;">
                Bu olay kaydını silmek istediğinize emin misiniz?
            </p>
        </div>
        <div class="modal-foot">
            <button type="button" class="btn-a btn-a--secondary" data-modal-close>Vazgeç</button>
            <button type="submit" id="delete-submit-btn" class="btn-a btn-a--danger">
                <svg class="icon" aria-hidden="true"><use href="#lucide-trash-2" /></svg>
                Sil
            </button>
        </div>
    </form>
</dialog>

@section Scripts {
    <script src="~/js/match-detail.js" asp-append-version="true"></script>
}
