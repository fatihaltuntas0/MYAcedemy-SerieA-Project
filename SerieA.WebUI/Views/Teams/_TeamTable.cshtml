@using SerieA.WebUI.ViewModels
@model TeamIndexViewModel

<section class="card-a" aria-label="Takım listesi">
    <form class="filter-bar" method="get" asp-action="Index" role="search">
        <div class="filter-search">
            <label class="field-label" for="f-q">Takım Ara</label>
            <div class="input-icon">
                <svg class="icon" aria-hidden="true"><use href="#lucide-search" /></svg>
                <input class="input-a" id="f-q" name="q" type="search" value="@Model.SearchQuery" placeholder="Takım, şehir veya stadyum" autocomplete="off">
            </div>
        </div>
        <div>
            <label class="field-label" for="f-region">Bölge</label>
            <select class="select-a" id="f-region" name="region">
                <option value="">Tüm Bölgeler</option>
                <option value="Kuzey İtalya" selected="@(Model.SelectedRegion == "Kuzey İtalya")">Kuzey İtalya</option>
                <option value="Orta İtalya" selected="@(Model.SelectedRegion == "Orta İtalya")">Orta İtalya</option>
                <option value="Güney İtalya" selected="@(Model.SelectedRegion == "Güney İtalya")">Güney İtalya</option>
                <option value="Adalar" selected="@(Model.SelectedRegion == "Adalar")">Adalar</option>
            </select>

        </div>
        <div>
            <label class="field-label" for="f-status">Durum</label>
            <select class="select-a" id="f-status" name="status">
                <option value="">Tümü</option>
                <option value="active" selected="@(Model.SelectedStatus?.ToLower() == "active")">Aktif (Serie A)</option>
                <option value="inactive" selected="@(Model.SelectedStatus?.ToLower() == "inactive")">Pasif</option>
            </select>
        </div>
        <div class="filter-actions">
            <a href="/Teams" class="btn-a btn-a--ghost">Temizle</a>
            <button type="submit" class="btn-a btn-a--secondary">Filtrele</button>
        </div>
    </form>

    <div class="table-scroll">
        <table class="team-table">
            <thead>
                <tr>
                    <th scope="col" class="col-id">#</th>
                    <th scope="col">Takım</th>
                    <th scope="col">Şehir / Bölge</th>
                    <th scope="col">Stadyum</th>
                    <th scope="col" class="col-num">Kapasite</th>
                    <th scope="col" class="col-num">Kuruluş</th>
                    <th scope="col">Renkler</th>
                    <th scope="col">Durum</th>
                    <th scope="col" class="col-actions">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Teams.Any())
                {
                    <tr class="table-empty">
                        <td colspan="9">
                            <div class="empty-state">
                                <div class="empty-state-icon">
                                    <svg class="icon" aria-hidden="true"><use href="#lucide-shield" /></svg>
                                </div>
                                <h3 class="empty-state-title">Eşleşen Takım Bulunamadı</h3>
                                <p class="empty-state-desc">Arama kriterlerinize veya seçilen filtrelere uygun Serie A kulübü bulunamadı. Filtreleri temizleyerek tüm kulüpleri listeleyebilirsiniz.</p>
                                <div class="empty-state-actions">
                                    <a href="/Teams" class="btn-a btn-a--secondary">Filtreleri Temizle</a>
                                    <button type="button" class="btn-a btn-a--primary" data-open-create>
                                        <svg class="icon" aria-hidden="true"><use href="#lucide-plus" /></svg>Yeni Takım Ekle
                                    </button>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                else
                {
                    var index = 1;
                    @foreach (var t in Model.Teams)
                    {
                        <tr data-id="@t.Id" class="@(!t.Status ? "is-inactive" : "")">
                            <td class="col-id">@(index++)</td>
                            <td>
                                <div class="team-cell">
                                    @if (!string.IsNullOrEmpty(t.LogoUrl) && (t.LogoUrl.StartsWith("http") || t.LogoUrl.StartsWith("/")))
                                    {
                                        <img class="team-crest" src="@t.LogoUrl" alt="@t.Name" onerror="this.style.display='none'; this.nextElementSibling.style.display='inline-grid';" />
                                        <span class="team-crest" style="display:none; --crest-a:@(string.IsNullOrEmpty(t.ColorOne) ? "#1E5BD8" : t.ColorOne); --crest-b:@(string.IsNullOrEmpty(t.ColorTwo) ? "#FFFFFF" : t.ColorTwo); --crest-ink:#FFFFFF;" aria-hidden="true">
                                            @t.Code
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="team-crest" style="--crest-a:@(string.IsNullOrEmpty(t.ColorOne) ? "#1E5BD8" : t.ColorOne); --crest-b:@(string.IsNullOrEmpty(t.ColorTwo) ? "#FFFFFF" : t.ColorTwo); --crest-ink:#FFFFFF;" aria-hidden="true">
                                            @t.Code
                                        </span>
                                    }
                                    <div>
                                        <span class="team-name">@t.Name</span>
                                        <span class="team-code">@t.Code</span>
                                    </div>
                                </div>
                            </td>

                            <td class="city-cell">
                                @t.City
                                @{
                                    var regionSlug = t.Region?.ToLower()
                                        .Replace("ı", "i").Replace("ü", "u").Replace("ö", "o").Replace("ş", "s").Replace("ç", "c").Replace("ğ", "g")
                                        .Replace(" ", "-") ?? "";
                                }
                                <small><span class="region region--@regionSlug">@t.Region</span></small>
                            </td>
                            <td>@t.Stadium</td>
                            <td class="col-num">@t.StadiumCapacity.ToString("N0")</td>
                            <td class="col-num">@t.FoundedYear.Year</td>
                            <td>
                                <span class="swatches" title="@t.ColorOne / @t.ColorTwo">
                                    <span class="swatch" style="--c:@t.ColorOne"></span>
                                    <span class="swatch" style="--c:@t.ColorTwo"></span>
                                </span>
                            </td>
                            <td>
                                <span class="badge-a badge-a--@(t.Status ? "active" : "inactive")">
                                    @(t.Status ? "Aktif" : "Pasif")
                                </span>
                            </td>
                            <td class="col-actions">
                                <div class="row-actions">
                                    <button type="button" class="act-btn" data-edit="@t.Id"
                                            data-team='@Json.Serialize(t)' title="Düzenle">
                                        <svg class="icon" aria-hidden="true"><use href="#lucide-pencil" /></svg>
                                    </button>
                                    <button type="button" class="act-btn act-btn--danger" data-delete="@t.Id" data-name="@t.Name" title="Sil">
                                        <svg class="icon" aria-hidden="true"><use href="#lucide-trash-2" /></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    <div class="table-foot">
        <span>Toplam @Model.Teams.Count takım gösteriliyor</span>
        <span>Serie A'da en fazla 20 aktif takım bulunabilir</span>
    </div>
</section>
