@using SerieA.WebUI.DTOs.Teams
@model LeagueSummaryDto

<section class="league-strip" aria-label="Lig özeti">
    <div class="strip-item strip-item--green">
        <span class="strip-icon"><svg class="icon" aria-hidden="true"><use href="#i-shield" /></svg></span>
        <div>
            <span class="strip-label">Aktif takım</span>
            <span class="strip-value">@Model.ActiveTeamCount <small>/ @Model.MaxTeamLimit</small></span>
        </div>
    </div>
    <div class="strip-item strip-item--blue">
        <span class="strip-icon"><svg class="icon" aria-hidden="true"><use href="#i-pin" /></svg></span>
        <div>
            <span class="strip-label">Temsil edilen şehir</span>
            <span class="strip-value">@Model.CityCount</span>
        </div>
    </div>
    <div class="strip-item strip-item--navy">
        <span class="strip-icon"><svg class="icon" aria-hidden="true"><use href="#i-stadium" /></svg></span>
        <div>
            <span class="strip-label">Toplam stadyum kapasitesi</span>
            <span class="strip-value">@Model.TotalStadiumCapacity.ToString("N0")</span>
        </div>
    </div>
    <div class="strip-item strip-item--red">
        <span class="strip-icon"><svg class="icon" aria-hidden="true"><use href="#i-clock" /></svg></span>
        <div>
            <span class="strip-label">En köklü kulüp</span>
            <span class="strip-value">@(string.IsNullOrEmpty(Model.OldestClubName) ? "-" : Model.OldestClubName) <small>@Model.OldestClubFoundedYear</small></span>
        </div>
    </div>
</section>
